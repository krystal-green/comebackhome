<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Come Back Home &mdash; Part One of The Home Trilogy</title>
<meta name="description" content="Come Back Home by Krystal Green. When everything is lost, where are you found? Part One of The Home Trilogy." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root {
    /* palette: the three greens you shared + a deep forest green for text */
    --mist:   #EDF8E9;   /* page background */
    --leaf:   #C7E9C0;   /* bands, soft panels */
    --fresh:  #A1D99B;   /* accents */
    --forest: #1F4D33;   /* buttons, strong accents */
    --ink:    #14301F;   /* headings */
    --soft:   #35503F;   /* body text */
    --muted:  #567060;   /* small text */
    --line:   #B5D9AE;
    --serif:  'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --sans:   'Figtree', 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body {
    font-family: var(--sans); color: var(--ink); background: var(--mist);
    line-height: 1.7; font-size: 1.02rem; overflow-x: hidden;
  }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  :focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }

  /* ---------- Header ---------- */
  header.site {
    display: flex; justify-content: space-between; align-items: center;
    padding: 22px 48px; position: relative; z-index: 5;
  }
  .site-title { font-family: var(--serif); font-size: 1.55rem; font-weight: 700; letter-spacing: .005em; cursor: pointer; }
  nav.main { display: flex; gap: 34px; }
  nav.main a { font-size: .98rem; font-weight: 500; padding-bottom: 4px; border-bottom: 2px solid transparent; transition: border-color .2s; }
  nav.main a:hover, nav.main a.active { border-bottom-color: var(--forest); }

  /* ---------- Shared ---------- */
  .view { display: none; }
  .view.active { display: block; }
  .container { max-width: 1160px; margin: 0 auto; padding: 0 48px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -.005em; line-height: 1.08; color: var(--ink); }
  .btn {
    display: inline-block; background: var(--forest); color: #fff;
    font-family: var(--sans); font-size: .95rem; font-weight: 600; letter-spacing: .02em;
    padding: 14px 32px; border-radius: 999px; border: 2px solid var(--forest); cursor: pointer;
    transition: background .2s, color .2s;
  }
  .btn:hover { background: var(--ink); border-color: var(--ink); }
  .btn.outline { background: transparent; color: var(--forest); }
  .btn.outline:hover { background: var(--forest); color: #fff; }
  .body-text { font-size: 1.05rem; color: var(--soft); max-width: 48ch; }
  .body-text + .body-text { margin-top: 14px; }

  /* ---------- Home: hero ---------- */
  .hero {
    margin: 4px 48px 0; border-radius: 28px; overflow: hidden;
    background:
      radial-gradient(ellipse 55% 80% at 82% 40%, rgba(161,217,155,.75), transparent 70%),
      linear-gradient(135deg, var(--leaf) 0%, #D9F0D3 55%, var(--mist) 100%);
  }
  .hero-grid {
    display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center;
    padding: 64px 64px 64px 72px;
  }
  .hero-eyebrow { font-family: var(--serif); font-style: italic; font-weight: 600; font-size: 1.35rem; color: var(--forest); margin-bottom: 14px; }
  .hero h1 { font-size: clamp(2.8rem, 5.6vw, 4.8rem); line-height: 1.02; max-width: 13ch; }
  .hero-book { margin-top: 26px; font-family: var(--serif); font-size: 1.6rem; font-weight: 600; color: var(--ink); }
  .hero-book small { display: block; font-family: var(--sans); font-size: .98rem; font-weight: 400; color: var(--soft); margin-top: 2px; }
  .hero .body-text { margin-top: 14px; }
  .hero .actions { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
  .isbn { margin-top: 20px; font-size: .88rem; color: var(--muted); }

  .covers { display: flex; justify-content: center; align-items: center; padding: 10px 0; }
  .covers img { width: 50%; border-radius: 4px; box-shadow: 0 26px 50px -18px rgba(20,48,31,.55); }
  .covers .front { position: relative; z-index: 2; transform: rotate(-3deg); }
  .covers .back  { margin-left: -12%; transform: rotate(4deg) translateY(22px); }
  .covers .front:only-child { width: 62%; }

  /* ---------- Home: pull quote ---------- */
  .pull { text-align: center; padding: 96px 24px 84px; }
  .pull blockquote { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(1.9rem, 3.4vw, 2.7rem); max-width: 24ch; margin: 0 auto; line-height: 1.25; color: var(--forest); }

  /* ---------- Home: story ---------- */
  .story { display: grid; grid-template-columns: 1fr 1.25fr; gap: 64px; padding: 10px 0 90px; align-items: start; }
  .story h2 { font-size: clamp(2.4rem, 4vw, 3.4rem); }
  .story p { font-size: 1.1rem; color: var(--soft); margin-bottom: 18px; max-width: 62ch; }
  .story .hook { color: var(--ink); font-weight: 600; }

  /* ---------- Home: trilogy ---------- */
  .trilogy { border-top: 1px solid var(--line); padding: 60px 0 80px; }
  .tri-label { font-family: var(--serif); font-size: 1.9rem; font-weight: 600; margin-bottom: 28px; }
  .tri-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tri-item { background: #F7FCF5; border: 1px solid var(--line); border-radius: 18px; padding: 26px 28px; }
  .tri-item .n { font-size: .9rem; color: var(--muted); font-weight: 500; }
  .tri-item .t { font-family: var(--serif); font-size: 2rem; font-weight: 600; margin: 4px 0 6px; line-height: 1.1; }
  .tri-item .s { font-size: .95rem; color: var(--soft); }
  .tri-item.live { background: var(--leaf); border-color: var(--fresh); }
  .tri-item.live .s { color: var(--forest); font-weight: 600; }

  /* ---------- Credits line + band ---------- */
  .credits-line { text-align: center; padding: 0 24px 70px; font-size: 1rem; color: var(--soft); }
  .credits-line a { border-bottom: 2px solid var(--fresh); color: var(--ink); font-weight: 500; }
  .credits-line span { margin: 0 10px; color: var(--muted); }
  .band { background: var(--leaf); padding: 80px 0; }
  .band-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .band h2 { font-size: clamp(2.2rem, 3.6vw, 3rem); margin-bottom: 14px; }
  .band .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-start; }

  /* ---------- About ---------- */
  .about-block { padding: 56px 0; }
  .about-block + .about-block { border-top: 1px solid var(--line); }
  .about-top { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: start; }
  .about-top h1, .about-top h2 { font-size: clamp(2.4rem, 4vw, 3.4rem); margin-bottom: 22px; }
  .about-top p { font-size: 1.1rem; color: var(--soft); max-width: 52ch; }
  .portrait {
    position: relative; width: 100%; aspect-ratio: 4 / 5; border-radius: 20px; overflow: hidden;
    background: var(--leaf);
  }
  .portrait::before {
    content: attr(data-initials); position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-family: var(--serif); font-size: 4rem; font-weight: 600; color: var(--forest); opacity: .55;
  }
  .portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* ---------- Contact / form ---------- */
  .contact-top { padding: 40px 0 56px; }
  .contact-top h1 { font-size: clamp(2.4rem, 4vw, 3.4rem); margin-bottom: 16px; }
  form.order { display: grid; gap: 18px; }
  form.order .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  form.order label { display: block; font-size: .92rem; font-weight: 500; color: var(--ink); margin-bottom: 6px; }
  form.order label small { color: var(--muted); margin-left: 4px; font-weight: 400; }
  form.order input, form.order textarea {
    width: 100%; font-family: inherit; font-size: 1rem; color: var(--ink);
    background: #fff; border: 1px solid #8fb98a; padding: 12px 18px; border-radius: 999px; outline: none;
  }
  form.order textarea { border-radius: 18px; min-height: 130px; resize: vertical; padding: 14px 18px; }
  form.order input:focus, form.order textarea:focus { border-color: var(--forest); box-shadow: 0 0 0 2px var(--forest); }
  .form-note { font-size: .95rem; margin-top: 8px; min-height: 1.2em; color: var(--soft); }

  /* ---------- Footer ---------- */
  footer.site { background: var(--ink); color: #E3F4DE; padding: 52px 48px 34px; }
  .foot-row { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .foot-title { font-family: var(--serif); font-size: 2rem; font-weight: 600; color: #fff; }
  .foot-mail { font-size: 1.1rem; color: var(--fresh); border-bottom: 1px solid transparent; }
  .foot-mail:hover { border-bottom-color: var(--fresh); }
  .foot-small { margin-top: 22px; font-size: .88rem; color: #A9C9A3; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    header.site { padding: 16px 20px; }
    .site-title { font-size: 1.3rem; }
    nav.main { gap: 20px; }
    .container { padding: 0 22px; }
    .hero { margin: 4px 14px 0; border-radius: 22px; }
    .hero-grid { grid-template-columns: 1fr; padding: 40px 24px 36px; gap: 28px; }
    .covers { order: -1; }
    .covers img { width: 46%; }
    .story, .band-grid, .about-top { grid-template-columns: 1fr; gap: 32px; }
    .about-block { padding: 40px 0; }
    .tri-grid { grid-template-columns: 1fr; }
    .pull { padding: 64px 24px 56px; }
    form.order .row { grid-template-columns: 1fr; }
    footer.site { padding: 40px 22px 28px; }
    .foot-title { font-size: 1.6rem; }
  }
</style>
</head>
<body>

<header class="site">
  <div class="site-title" data-go="home">Come Back Home</div>
  <nav class="main">
    <a href="#about" data-go="about">About</a>
    <a href="#contact" data-go="contact">Contact</a>
  </nav>
</header>

<!-- ======================= HOME ======================= -->
<main class="view active" id="view-home">

  <section class="hero">
    <div class="hero-grid">
      <div>
        <div class="hero-eyebrow">Part One of The Home Trilogy</div>
        <h1>When everything is lost, where are you found?</h1>
        <div class="hero-book">Come Back Home<small>A novel by Krystal Green</small></div>
        <p class="body-text">23-year-old Christine Tavley is searching for the truth behind the explosion that wiped her hometown off the map &mdash; and the serial bomber hiding behind the symbol of a green fairy.</p>
        <div class="actions">
          <a class="btn" href="#" target="_blank" rel="noopener noreferrer">Buy Now</a>
          <a class="btn outline" href="#contact" data-go="contact">Order by form</a>
        </div>
        <div class="isbn">ISBN 978-93-6012-157-0</div>
      </div>
      <div class="covers">
        <img class="front" src="Front_cover_page.jpeg" alt="Come Back Home &mdash; front cover">
        <img class="back" src="Back_cover_page.jpeg" alt="Come Back Home &mdash; back cover" onerror="this.remove()">
      </div>
    </div>
  </section>

  <section class="pull">
    <blockquote>&ldquo;Curiosity in the wrong place&hellip; It can have dire consequences.&rdquo;</blockquote>
  </section>

  <div class="container">
    <section class="story">
      <h2>The Story</h2>
      <div>
        <p>23-year-old Christine Tavley has been searching for the truth behind the incident that destroyed her life five years ago. The explosion of 22nd March 1982 wiped her hometown, Totin, off the map. It was the beginning of the serial bomber known as Absinthe. Hiding behind the symbol of a green fairy, Absinthe comes alive with a broadcast. Two weeks later, another town vanishes just like Totin.</p>
        <p>Christine's survival is fueled by the people she has left, the old memories, and the hope that she will one day get to the bottom of what Absinthe really wants. She visits the deserted town in search of answers which ultimately forces her to look closer than she expected. Getting closer to the truth feels freeing &mdash; until she overhears something she wasn't supposed to.</p>
        <p class="hook">The truth that was supposed to be worth the loss becomes deadly, trapping her in ways she had never imagined.</p>
      </div>
    </section>

    <section class="trilogy">
      <div class="tri-label">The Home Trilogy</div>
      <div class="tri-grid">
        <div class="tri-item live"><div class="n">Book 1</div><div class="t">Come Back Home</div><div class="s">Available now</div></div>
        <div class="tri-item"><div class="n">Book 2</div><div class="t">Back Home</div><div class="s">Coming soon</div></div>
        <div class="tri-item"><div class="n">Book 3</div><div class="t">Home</div><div class="s">Coming soon</div></div>
      </div>
    </section>
  </div>

  <div class="credits-line">
    Written by <a href="#about" data-go="about">Krystal Green</a><span>&middot;</span>
    Edited by <a href="#about" data-go="about">Prathamesh S. Kadam</a><span>&middot;</span>
    Cover design by <a href="#about" data-go="about">Aditi Srivastava</a>
  </div>

  <section class="band">
    <div class="container band-grid">
      <div>
        <h2>Get your copy</h2>
        <p class="body-text">Buy online, or send an order request through the form and we'll get back to you with the details.</p>
      </div>
      <div class="actions">
        <a class="btn" href="#" target="_blank" rel="noopener noreferrer">Buy Now</a>
        <a class="btn outline" href="#contact" data-go="contact">Order by form</a>
      </div>
    </div>
  </section>
</main>

<!-- ======================= ABOUT ======================= -->
<main class="view" id="view-about">
  <div class="container">

    <section class="about-block">
      <div class="about-top">
        <div>
          <h1>About the Author</h1>
          <p>First of all, she is a wonderful person by nature and heart. This book along with her dream to become a writer started in 2016. And she was 13 at that time. Her writing was not good. Neither was her story. But ever since she was young, she has been creating stories. They always materialized in the real world in some ways, whether it was creating a 'movie' via her mother's phone with her toys as the cast or imagining scenarios where people were always in need of a savior (conveniently, She was always available to save people). Throughout her life, she has changed and so has her thinking. And that has contributed to her story evolving a lot since it first started.</p>
        </div>
        <div class="portrait" data-initials="KG"><img src="shruti.jpeg" alt="Krystal Green" onerror="this.remove()"></div>
      </div>
    </section>

    <section class="about-block">
      <div class="about-top">
        <div>
          <h2>About the Editor</h2>
          <p>Prathamesh S. Kadam edited and typeset Come Back Home. By day he researches supernovae and machine learning in astrophysics &mdash; by night, he shapes stories into their final form.</p>
        </div>
        <div class="portrait" data-initials="PK"><img src="prathamesh.jpg" alt="Prathamesh S. Kadam" onerror="this.remove()"></div>
      </div>
    </section>

    <section class="about-block">
      <div class="about-top">
        <div>
          <h2>About the Cover Designer</h2>
          <p>Aditi Srivastava designed the cover and illustrations for Come Back Home. Her full bio is coming soon.</p>
        </div>
        <div class="portrait" data-initials="AS"><img src="aditi.jpg" alt="Aditi Srivastava" onerror="this.remove()"></div>
      </div>
    </section>

  </div>
</main>

<!-- ======================= CONTACT ======================= -->
<main class="view" id="view-contact">
  <div class="container contact-top">
    <h1>Order Your Copy</h1>
    <p class="body-text">Fill out the form with your details and the number of copies you'd like, and we'll get back to you with how to complete your order.</p>
  </div>

  <section class="band">
    <div class="container band-grid" style="align-items:start;">
      <div>
        <h2>Send an order request</h2>
        <p class="body-text">Prefer to buy online? Use the Buy Now button on the home page.</p>
      </div>
      <form class="order" id="orderForm" novalidate>
        <div class="row">
          <div><label for="fn">First Name <small>(required)</small></label><input id="fn" name="first_name" type="text" required></div>
          <div><label for="ln">Last Name <small>(required)</small></label><input id="ln" name="last_name" type="text" required></div>
        </div>
        <div><label for="em">Email <small>(required)</small></label><input id="em" name="email" type="email" required></div>
        <div><label for="msg">Message <small>(required)</small></label><textarea id="msg" name="message" placeholder="Number of copies, delivery address, anything else we should know" required></textarea></div>
        <div><button class="btn" type="submit">Send</button><div class="form-note" id="formNote"></div></div>
      </form>
    </div>
  </section>
</main>

<footer class="site">
  <div class="foot-row">
    <div class="foot-title">Come Back Home</div>
    <a class="foot-mail" id="footMail" href="#">krstalgreen27@gmail.com</a>
  </div>
  <div class="foot-small">&copy; 2026 Come Back Home &middot; Krystal Green &middot; ISBN 978-93-6012-157-0</div>
</footer>

<script>
  /* ====== SET THESE TWO ====== */
  const BOOK_EMAIL = 'krystalgreen27@gmail.com';   // shown in the footer and used for the order form
  const FORM_ENDPOINT = '';                        // optional: a Formspree URL, e.g. https://formspree.io/f/xxxxxxx
  /* =========================== */

  const footMail = document.getElementById('footMail');
  footMail.textContent = BOOK_EMAIL;
  footMail.href = 'mailto:' + BOOK_EMAIL;

  const views = { home: 'view-home', about: 'view-about', contact: 'view-contact' };
  function show(name) {
    if (!views[name]) name = 'home';
    Object.entries(views).forEach(([k, id]) => document.getElementById(id).classList.toggle('active', k === name));
    document.querySelectorAll('nav.main a').forEach(a => a.classList.toggle('active', a.dataset.go === name));
    window.scrollTo(0, 0);
  }
  document.querySelectorAll('[data-go]').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      const name = el.dataset.go;
      show(name);
      history.replaceState(null, '', name === 'home' ? location.pathname : '#' + name);
    });
  });
  show((location.hash || '').slice(1));

  /* order form */
  const form = document.getElementById('orderForm');
  const note = document.getElementById('formNote');
  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (!form.checkValidity()) { note.textContent = 'Please fill in all required fields.'; return; }
    const data = Object.fromEntries(new FormData(form).entries());
    if (FORM_ENDPOINT) {
      try {
        const r = await fetch(FORM_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error();
        form.reset(); note.textContent = 'Thank you! Your request has been sent.';
      } catch (_) { note.textContent = 'Something went wrong. Please email ' + BOOK_EMAIL + ' instead.'; }
    } else {
      const subject = encodeURIComponent('Order request: Come Back Home');
      const body = encodeURIComponent('Name: ' + data.first_name + ' ' + data.last_name + '\nEmail: ' + data.email + '\n\n' + data.message);
      window.location.href = 'mailto:' + BOOK_EMAIL + '?subject=' + subject + '&body=' + body;
      note.textContent = 'Opening your email app to send the request…';
    }
  });
</script>
</body>
</html>
